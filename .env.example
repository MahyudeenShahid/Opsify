# ============================================================
# Opsify Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- AI / LLM ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google Maps (Optional — demo mode used if missing) ---
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- API Security ---
# A secret key clients must send in the X-API-Key header to access the API.
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
OPSIFY_API_KEY=your_strong_secret_api_key_here

# --- Google Sheets (Optional — CSV fallback used if missing) ---
# Path to your service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json
GOOGLE_SHEETS_NAME=Opsify Inventory Sync
